# 桌面宠物 · 环境变量模板
# 复制为 backend/config/.env 后填写。.env 不入 Git。
# 变量说明见 Arch.md §8。

# ---- 后端服务 ----
PET_HOST=127.0.0.1
PET_PORT=0
PET_TOKEN=change-me-to-a-random-string
PET_DATA_DIR=backend/data
PET_PERSONA_FILE=backend/config/persona.yaml
PET_TIMEZONE=Asia/Shanghai
PET_LOG_LEVEL=INFO

# ---- 勿扰与主动消息频率 ----
PET_QUIET_HOURS=23:00-08:00
PET_PROACTIVE_MAX_PER_HOUR=2
PET_PROACTIVE_MAX_PER_DAY=15

# ---- 模型 provider ----
# 启用的 provider 列表，名称须与 backend/config/llm.yaml 中的 providers 一致。
# 每个 provider 需要 <NAME>_BASE_URL 与 <NAME>_API_KEY。
# <NAME>_API_KEY 的值是系统环境变量名，不是密钥本身；真正的密钥写在该系统环境变量中。
LLM_PROVIDERS=deepseek,openai

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=DEEPSEEK_KEY

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=OPENAI_KEY

# ---- 天气 ----
WEATHER_SOURCE=qweather
WEATHER_LOCATION_MODE=auto
WEATHER_MANUAL_CITY=上海
QWEATHER_API_HOST=
QWEATHER_CREDENTIAL=

# ---- 受限能力（逗号分隔，留空即全部禁止） ----
CAPABILITY_ALLOWED_APPS=
CAPABILITY_ALLOWED_DOMAINS=
CAPABILITY_ALLOWED_DIRS=
