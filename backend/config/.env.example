# 桌面宠物 · 环境变量模板
# 复制为 backend/config/.env 后填写。.env 含密钥，不要提交到 Git。
# 变量说明见 Arch.md §8。

# ---- 后端服务 ----
PET_HOST=127.0.0.1
PET_PORT=0
PET_TOKEN=change-me-to-a-random-string
PET_DATA_DIR=backend/data
PET_PERSONA_FILE=backend/config/persona.yaml
PET_TIMEZONE=Asia/Shanghai
PET_LOG_LEVEL=INFO

# ---- 勿扰与主动消息频率 ----
PET_QUIET_HOURS=23:00-08:00
PET_PROACTIVE_MAX_PER_HOUR=2
PET_PROACTIVE_MAX_PER_DAY=15

# ---- 对话模型（OpenAI 兼容） ----
LLM_CHAT_BASE_URL=https://api.example.com/v1
LLM_CHAT_API_KEY=your-api-key
LLM_CHAT_MODEL=your-chat-model

# ---- 整理模型（可选，未设置则沿用对话模型配置） ----
LLM_CONSOLIDATE_BASE_URL=
LLM_CONSOLIDATE_API_KEY=
LLM_CONSOLIDATE_MODEL=your-cheap-model

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ---- 天气 ----
WEATHER_SOURCE=qweather
WEATHER_LOCATION_MODE=auto
WEATHER_MANUAL_CITY=上海
QWEATHER_API_HOST=
QWEATHER_CREDENTIAL=

# ---- 受限能力（逗号分隔，留空即全部禁止） ----
CAPABILITY_ALLOWED_APPS=
CAPABILITY_ALLOWED_DOMAINS=
CAPABILITY_ALLOWED_DIRS=
