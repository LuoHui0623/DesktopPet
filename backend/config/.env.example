# 桌面宠物 · 环境变量模板
# 复制为 backend/config/.env 后填写。.env 不入 Git。
# 变量说明见 Arch.md §8。

# ---- 后端服务 ----
PET_HOST=127.0.0.1
PET_PORT=0
PET_TOKEN=change-me-to-a-random-string
PET_DATA_DIR=backend/data
PET_PERSONAS_DIR=backend/config/personas
PET_TIMEZONE=Asia/Shanghai
PET_LOG_LEVEL=INFO

# 状态窗口展示模式。1/true/yes/on 为开发模式（显示完整请求/回复）；
# 仅由 Tauri 调试构建拉起后端时注入，正式构建不设置，通常留空。
# PET_DEV_MODE=1

# ---- 模型 provider ----
# 启用的 provider，名称须与 backend/config/llm.yaml 中的 providers 一致（小写）。
LLM_PROVIDERS=deepseek,opencode

# 每个 provider 的 Base URL。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# 密钥值不写在本文件中。下面的键只写“系统环境变量名”，实际密钥从该系统环境变量读取。
# 不写该键时默认读 <PROVIDER>_API_KEY（大写）。值须为大写变量名，写密钥本身会启动失败。
#   DEEPSEEK_API_KEY=PET_API_KEY
#   OPENCODE_API_KEY

# ---- 默认模型（按能力指定） ----
# 格式：<name>，或 <provider>/<name>。name 为 llm.yaml 中模型的标签（同一 provider 内唯一）。
# 同名标签出现在多个 provider 中时，必须使用 <provider>/<name>。
DEFAULT_CHAT_MODEL=deepseek-flash
DEFAULT_CONSOLIDATE_MODEL=deepseek-flash

# ---- 日志入库 ----
# 批次满 PET_LOG_QUEUE_SIZE 条，或自批次第一条起超过 PET_LOG_MAX_WAIT_SECONDS 秒，即写入数据库。
PET_LOG_QUEUE_SIZE=20
PET_LOG_MAX_WAIT_SECONDS=30

# ---- 天气 ----
WEATHER_SOURCE=qweather
WEATHER_LOCATION_MODE=auto
WEATHER_MANUAL_CITY=上海
QWEATHER_API_HOST=
QWEATHER_CREDENTIAL=

# ---- 受限能力（逗号分隔，留空即全部禁止） ----
CAPABILITY_ALLOWED_APPS=
CAPABILITY_ALLOWED_DOMAINS=
CAPABILITY_ALLOWED_DIRS=
