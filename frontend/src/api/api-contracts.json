{
  "operations": [
    {
      "operationId": "get_active_llm",
      "method": "GET",
      "path": "/api/llm/active",
      "tags": [
        "llm"
      ],
      "request": null,
      "responses": {
        "200": {
          "$ref": "#/components/schemas/ActiveLlmResponse"
        }
      }
    },
    {
      "operationId": "health",
      "method": "GET",
      "path": "/api/health",
      "tags": [
        "system"
      ],
      "request": null,
      "responses": {
        "200": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Response Health",
          "type": "object"
        }
      }
    },
    {
      "operationId": "list_chat_history",
      "method": "GET",
      "path": "/api/chat/history",
      "tags": [
        "chat"
      ],
      "request": null,
      "responses": {
        "200": {
          "$ref": "#/components/schemas/ChatHistoryResponse"
        },
        "422": null
      }
    },
    {
      "operationId": "list_llm_providers",
      "method": "GET",
      "path": "/api/llm/providers",
      "tags": [
        "llm"
      ],
      "request": null,
      "responses": {
        "200": {
          "$ref": "#/components/schemas/LlmProvidersResponse"
        }
      }
    },
    {
      "operationId": "reload_llm_config",
      "method": "POST",
      "path": "/api/llm/reload",
      "tags": [
        "llm"
      ],
      "request": null,
      "responses": {
        "200": {
          "$ref": "#/components/schemas/ReloadResponse"
        },
        "422": null
      }
    },
    {
      "operationId": "send_chat",
      "method": "POST",
      "path": "/api/chat",
      "tags": [
        "chat"
      ],
      "request": {
        "$ref": "#/components/schemas/ChatRequest"
      },
      "responses": {
        "200": {
          "$ref": "#/components/schemas/ChatReplyResponse"
        },
        "422": null,
        "502": null,
        "503": null
      }
    },
    {
      "operationId": "set_active_llm",
      "method": "PUT",
      "path": "/api/llm/active",
      "tags": [
        "llm"
      ],
      "request": {
        "$ref": "#/components/schemas/ActiveLlmRequest"
      },
      "responses": {
        "200": {
          "$ref": "#/components/schemas/ActiveLlmResponse"
        },
        "422": null
      }
    },
    {
      "operationId": "shutdown",
      "method": "POST",
      "path": "/api/shutdown",
      "tags": [
        "system"
      ],
      "request": null,
      "responses": {
        "202": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Response Shutdown",
          "type": "object"
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "ActiveLlmRequest": {
        "additionalProperties": false,
        "properties": {
          "chat": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActiveSelection"
              },
              {
                "type": "null"
              }
            ]
          },
          "consolidate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActiveSelection"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "ActiveLlmRequest",
        "type": "object"
      },
      "ActiveLlmResponse": {
        "properties": {
          "chat": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActiveModelInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "consolidate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActiveModelInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "chat",
          "consolidate"
        ],
        "title": "ActiveLlmResponse",
        "type": "object"
      },
      "ActiveModelInfo": {
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "source": {
            "enum": [
              "database",
              "env"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model",
          "source"
        ],
        "title": "ActiveModelInfo",
        "type": "object"
      },
      "ActiveSelection": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model"
        ],
        "title": "ActiveSelection",
        "type": "object"
      },
      "ChatChunkEvent": {
        "properties": {
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "chat.chunk",
            "default": "chat.chunk",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "text"
        ],
        "title": "ChatChunkEvent",
        "type": "object"
      },
      "ChatDoneEvent": {
        "properties": {
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "chat.done",
            "default": "chat.done",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "text"
        ],
        "title": "ChatDoneEvent",
        "type": "object"
      },
      "ChatHistoryItem": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "date": {
            "title": "Date",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "date",
          "role",
          "content",
          "created_at"
        ],
        "title": "ChatHistoryItem",
        "type": "object"
      },
      "ChatHistoryResponse": {
        "properties": {
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ChatHistoryItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "has_more"
        ],
        "title": "ChatHistoryResponse",
        "type": "object"
      },
      "ChatReplyResponse": {
        "properties": {
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "recorded": {
            "title": "Recorded",
            "type": "boolean"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "text",
          "recorded"
        ],
        "title": "ChatReplyResponse",
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "DefaultInfo": {
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model"
        ],
        "title": "DefaultInfo",
        "type": "object"
      },
      "LlmProvidersResponse": {
        "properties": {
          "defaults": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DefaultInfo"
            },
            "title": "Defaults",
            "type": "object"
          },
          "last_reload_errors": {
            "items": {
              "type": "string"
            },
            "title": "Last Reload Errors",
            "type": "array"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderInfo"
            },
            "title": "Providers",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "version",
          "providers",
          "defaults",
          "warnings",
          "last_reload_errors"
        ],
        "title": "LlmProvidersResponse",
        "type": "object"
      },
      "ModelInfo": {
        "properties": {
          "api": {
            "title": "Api",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "name",
          "id",
          "api",
          "roles"
        ],
        "title": "ModelInfo",
        "type": "object"
      },
      "ProviderInfo": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            },
            "title": "Models",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "name",
          "display_name",
          "available",
          "reason",
          "models"
        ],
        "title": "ProviderInfo",
        "type": "object"
      },
      "ReloadResponse": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "ok",
          "version",
          "warnings"
        ],
        "title": "ReloadResponse",
        "type": "object"
      },
      "ServerEvent": {
        "discriminator": {
          "mapping": {
            "chat.chunk": "#/components/schemas/ChatChunkEvent",
            "chat.done": "#/components/schemas/ChatDoneEvent",
            "status": "#/components/schemas/StatusEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/StatusEvent"
          },
          {
            "$ref": "#/components/schemas/ChatChunkEvent"
          },
          {
            "$ref": "#/components/schemas/ChatDoneEvent"
          }
        ]
      },
      "StatusEvent": {
        "properties": {
          "state": {
            "enum": [
              "idle",
              "thinking",
              "speaking",
              "executing",
              "sleeping"
            ],
            "title": "State",
            "type": "string"
          },
          "type": {
            "const": "status",
            "default": "status",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "title": "StatusEvent",
        "type": "object"
      }
    }
  }
}
