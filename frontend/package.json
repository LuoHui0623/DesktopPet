{
  "name": "pet-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "桌面宠物前端（Tauri 2 + React）",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "vite:dev": "vite",
